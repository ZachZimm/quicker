[Unit]
Description=Quicker web application
After=network.target

[Service]
Type=simple
User=QUICKER_USER
WorkingDirectory=QUICKER_ROOT
EnvironmentFile=QUICKER_ROOT/.env
ExecStart=QUICKER_ROOT/.venv/bin/quicker serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
